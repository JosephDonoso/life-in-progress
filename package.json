{
  "name": "life-in-progress",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:check && tsc -b && vite build",
    "catalog:check": "node supabase/generate-seed.mjs --check",
    "catalog:generate": "node supabase/generate-seed.mjs",
    "icons:sync": "node scripts/sync-achievement-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src tests docs catalogo.json README.md vite.config.ts playwright.config.ts supabase/generate-seed.mjs",
    "test": "playwright test",
    "test:db": "node tests/database.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
